# Скопируйте в .env в корне репозитория: copy env.example .env  (PowerShell: Copy-Item env.example .env)
# docker compose подхватывает .env автоматически.

# --- gRPC user-service (хост: см. GRPC_PORT_HOST при пробросе порта) ---
GRPC_PORT=50051
GRPC_PORT_HOST=50051

# --- Postgres (локальный доступ с хоста при compose: порт POSTGRES_PORT_HOST) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=user_service
POSTGRES_PORT_HOST=5433

# URL для бинарника на хосте (make integration / smoke / push-consumer без Docker)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/user_service?sslmode=disable

# Профиль `test` в docker-compose
POSTGRES_TEST_DB=user_service_test
POSTGRES_TEST_PORT_HOST=5434

# --- S3 / MinIO ---
# Внутри Docker-сети compose укажите minio:9000 (см. docker-compose app).
# Для запуска только бинарника user-service на хосте — localhost и порт MinIO.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fotos
S3_USE_SSL=false

# --- Kafka + push-consumer ---
# СОГЛАСОВАНИЕ С chat-message-mgz: один и тот же KAFKA_TOPIC_CHAT_MESSAGES и один брокер Kafka.
# - Оба сервиса в Docker (одна сеть): используйте один compose / внешнюю сеть и KAFKA_BROKERS=kafka:9092.
# - chat на хосте, user в Docker: KAFKA_BROKERS для chat = localhost:9092, проброс порта 9092.
# - Если брокеры несовпадают, producer и consumer просто видят разные кластеры — пуш не придёт.
KAFKA_BROKERS=localhost:9092
KAFKA_PORT_HOST=9092
KAFKA_TOPIC_CHAT_MESSAGES=chat.messages
KAFKA_CONSUMER_GROUP=user-mgz-push-consumer

# noop | composite | fcm | firebase | real | live
PUSH_PROVIDER=composite

# Firebase (FCM): положите ключ в secrets/firebase-adminsdk.json (инструкция — secrets/README.txt).
# Одна строка-команда для Windows после скачивания ключа (из каталога user-mgz в PowerShell):
#   Copy-Item "$env:USERPROFILE\Downloads\mgz-project-*-firebase-adminsdk*.json" -Destination "secrets\firebase-adminsdk.json" -Force
#
# Переменные ниже нужны локальному запуску (go run ./cmd/push-consumer). Контейнер push-consumer получает файл из volume (см. docker-compose.yml) и игнорирует эти пути.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-adminsdk.json
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-adminsdk.json

FIREBASE_CREDENTIALS_JSON=

# Apple Push (нативный device token, provider=apns в user_push_tokens)
APNS_KEY_PATH=
APNS_KEY_PEM=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
# true — sandbox APNs для dev-сборок iOS
APNS_SANDBOX=false
