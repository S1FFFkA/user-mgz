# App / gRPC
GRPC_PORT=50051
GRPC_PORT_HOST=50051

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=user_service
POSTGRES_PORT_HOST=5433

# Профиль `test` в docker-compose (отдельная БД для go test, порт по умолчанию 5434)
POSTGRES_TEST_DB=user_service_test
POSTGRES_TEST_PORT_HOST=5434

# S3 / MinIO (для docker-compose ниже — значения по умолчанию для сервиса app)
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fotos
S3_USE_SSL=false
